rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Health & Connection Ping Document
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    // --- Helper Functions for Security & Validation ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Super Admin độc quyền: cualokhachsan@gmail.com (Bắt buộc xác thực email_verified == true để chống giả mạo)
    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() == 'cualokhachsan@gmail.com';
    }

    // Kiểm tra xem tài khoản mục tiêu có phải là Master Admin (cualokhachsan@gmail.com) hay không
    function isProtectedMasterAdminDoc(docId, existingData) {
      return docId == 'admin' ||
        docId == 'account-admin' ||
        ('email' in existingData && existingData.email is string && existingData.email.lower() == 'cualokhachsan@gmail.com');
    }

    // --- Validation Helpers for Each Entity ---

    function isValidPageRecord(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.staffName is string && data.staffName.size() <= 100 &&
             data.pageName is string && data.pageName.size() <= 200 &&
             data.targetPosts is number &&
             data.actualPosts is number &&
             data.isCompleted is bool &&
             (!('pageLink' in data) || (data.pageLink is string && data.pageLink.size() <= 500)) &&
             (!('viaUid' in data) || (data.viaUid is string && data.viaUid.size() <= 100)) &&
             (!('fullVia' in data) || (data.fullVia is string && data.fullVia.size() <= 500)) &&
             (!('bmNote' in data) || (data.bmNote is string && data.bmNote.size() <= 500)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('blockStatus' in data) || (data.blockStatus is string && data.blockStatus.size() <= 50)) &&
             (!('postingMethod' in data) || (data.postingMethod is string && data.postingMethod.size() <= 50)) &&
             (!('interaction' in data) || (data.interaction is string && data.interaction.size() <= 50)) &&
             (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
             (!('postingDate' in data) || (data.postingDate is string && data.postingDate.size() <= 50)) &&
             (!('interactionDate' in data) || (data.interactionDate is string && data.interactionDate.size() <= 50)) &&
             (!('likeCountStatus' in data) || (data.likeCountStatus is string && data.likeCountStatus.size() <= 50)) &&
             (!('isViaError' in data) || data.isViaError is bool) &&
             (!('viaStatus' in data) || (data.viaStatus is string && data.viaStatus.size() <= 50)) &&
             (!('viaErrorNote' in data) || (data.viaErrorNote is string && data.viaErrorNote.size() <= 500)) &&
             (!('isViaFixed' in data) || data.isViaFixed is bool) &&
             (!('viaSharedNote' in data) || (data.viaSharedNote is string && data.viaSharedNote.size() <= 500)) &&
             (!('viaTransferStatus' in data) || (data.viaTransferStatus is string && data.viaTransferStatus.size() <= 50)) &&
             (!('viaTransferNote' in data) || (data.viaTransferNote is string && data.viaTransferNote.size() <= 500)) &&
             (!('viaTransferColor' in data) || (data.viaTransferColor is string && data.viaTransferColor.size() <= 50)) &&
             (!('viaTransferUpdatedAt' in data) || (data.viaTransferUpdatedAt is string && data.viaTransferUpdatedAt.size() <= 50));
    }

    function isValidViaItem(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.uid is string && data.uid.size() <= 100 &&
             data.staffName is string && data.staffName.size() <= 100 &&
             (!('pass' in data) || (data.pass is string && data.pass.size() <= 200)) &&
             (!('twoFa' in data) || (data.twoFa is string && data.twoFa.size() <= 200)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('isError' in data) || data.isError is bool) &&
             (!('isFixed' in data) || data.isFixed is bool) &&
             (!('rawFullVia' in data) || (data.rawFullVia is string && data.rawFullVia.size() <= 500)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidAccount(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 100 &&
             data.role in ['admin', 'staff'] &&
             data.status in ['approved', 'pending', 'blocked'] &&
             (!('pin' in data) || (data.pin is string && data.pin.size() <= 50)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 50)) &&
             (!('requestNote' in data) || (data.requestNote is string && data.requestNote.size() <= 500)) &&
             (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 500)) &&
             (!('allowedTabs' in data) || (data.allowedTabs is list && data.allowedTabs.size() <= 20)) &&
             (!('wpEmployeeCode' in data) || (data.wpEmployeeCode is string && data.wpEmployeeCode.size() <= 50)) &&
             (!('wpAllowedEmployeeCodes' in data) || (data.wpAllowedEmployeeCodes is list && data.wpAllowedEmployeeCodes.size() <= 50));
    }

    function isValidSetting(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('adminPin' in data) || (data.adminPin is string && data.adminPin.size() <= 50)) &&
             // Khóa cứng quyền sở hữu: adminEmail & ownerEmail phải là cualokhachsan@gmail.com (hoặc do chính SuperAdmin sửa)
             (!('adminEmail' in data) || (data.adminEmail is string && data.adminEmail.size() <= 200 && (data.adminEmail.lower() == 'cualokhachsan@gmail.com' || isSuperAdmin()))) &&
             (!('adminName' in data) || (data.adminName is string && data.adminName.size() <= 100)) &&
             (!('requireApproval' in data) || data.requireApproval is bool) &&
             (!('requireGoogleLoginOnly' in data) || data.requireGoogleLoginOnly is bool) &&
             (!('customStaffList' in data) || (data.customStaffList is list && data.customStaffList.size() <= 200)) &&
             (!('redirectConfigJson' in data) || (data.redirectConfigJson is string && data.redirectConfigJson.size() <= 5000)) &&
             (!('targetProjectId' in data) || (data.targetProjectId is string && data.targetProjectId.size() <= 200)) &&
             (!('targetDatabaseId' in data) || (data.targetDatabaseId is string && data.targetDatabaseId.size() <= 200)) &&
             (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 200 && (data.ownerEmail.lower() == 'cualokhachsan@gmail.com' || isSuperAdmin()))) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidSharedAccount(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.websiteName is string && data.websiteName.size() <= 200 &&
             data.username is string && data.username.size() <= 200 &&
             data.password is string && data.password.size() <= 200 &&
             (!('websiteUrl' in data) || (data.websiteUrl is string && data.websiteUrl.size() <= 500)) &&
             (!('twoFa' in data) || (data.twoFa is string && data.twoFa.size() <= 200)) &&
             (!('assignedStaff' in data) || (data.assignedStaff is list && data.assignedStaff.size() <= 100)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidGroupRecord(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.groupName is string && data.groupName.size() <= 200 &&
             data.uid is string && data.uid.size() <= 100 &&
             (!('groupId' in data) || (data.groupId is string && data.groupId.size() <= 100)) &&
             (!('groupLink' in data) || (data.groupLink is string && data.groupLink.size() <= 500)) &&
             (!('viaName' in data) || (data.viaName is string && data.viaName.size() <= 100)) &&
             (!('staffName' in data) || (data.staffName is string && data.staffName.size() <= 100)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('joinStatus' in data) || (data.joinStatus is string && data.joinStatus.size() <= 50)) &&
             (!('interactionStatus' in data) || (data.interactionStatus is string && data.interactionStatus.size() <= 50)) &&
             (!('isHighlighted' in data) || data.isHighlighted is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidProxyItem(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.ip is string && data.ip.size() <= 100 &&
             data.port is string && data.port.size() <= 20 &&
             (!('username' in data) || (data.username is string && data.username.size() <= 100)) &&
             (!('password' in data) || (data.password is string && data.password.size() <= 100)) &&
             (!('protocol' in data) || (data.protocol is string && data.protocol.size() <= 20)) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 20)) &&
             (!('fullProxy' in data) || (data.fullProxy is string && data.fullProxy.size() <= 300)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             (!('provider' in data) || (data.provider is string && data.provider.size() <= 200)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('assignedStaff' in data) || (data.assignedStaff is list && data.assignedStaff.size() <= 100) || (data.assignedStaff is string && data.assignedStaff.size() <= 100)) &&
             (!('assignedViaUids' in data) || (data.assignedViaUids is list && data.assignedViaUids.size() <= 200)) &&
             (!('expireDate' in data) || (data.expireDate is string && data.expireDate.size() <= 50)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('isRotating' in data) || data.isRotating is bool) &&
             (!('rotateUrl' in data) || (data.rotateUrl is string && data.rotateUrl.size() <= 500)) &&
             (!('resetUrl' in data) || (data.resetUrl is string && data.resetUrl.size() <= 500)) &&
             (!('lastResetTime' in data) || data.lastResetTime is number) &&
             (!('lastChecked' in data) || (data.lastChecked is string && data.lastChecked.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidMonthlyFinance(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('monthKey' in data) || (data.monthKey is string && data.monthKey.size() <= 20)) &&
             (!('month' in data) || data.month is number) &&
             (!('year' in data) || data.year is number) &&
             (!('totalRevenue' in data) || data.totalRevenue is number) &&
             (!('officeCost' in data) || data.officeCost is number) &&
             (!('electricityCost' in data) || data.electricityCost is number) &&
             (!('waterCost' in data) || data.waterCost is number) &&
             (!('totalSalary' in data) || data.totalSalary is number) &&
             (!('totalExpenses' in data) || data.totalExpenses is number) &&
             (!('netProfit' in data) || data.netProfit is number) &&
             (!('salaryItems' in data) || data.salaryItems is list) &&
             (!('revenueItems' in data) || data.revenueItems is list) &&
             (!('customExpenses' in data) || data.customExpenses is list);
    }

    function isValidImageTask(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.title is string && data.title.size() <= 300 &&
             (!('assignedStaff' in data) || (data.assignedStaff is string && data.assignedStaff.size() <= 100)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('priority' in data) || (data.priority is string && data.priority.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('targetPage' in data) || (data.targetPage is string && data.targetPage.size() <= 200)) &&
             (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // --- Collection Match Rules ---

    // 1. Page Records (Fanpages & Daily Progress)
    match /pageRecords/{recordId} {
      allow read: if true;
      allow create: if isValidId(recordId) && isValidPageRecord(request.resource.data);
      allow update: if isValidId(recordId) && isValidPageRecord(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    // 2. Full Vias
    match /vias/{viaId} {
      allow read: if true;
      allow create: if isValidId(viaId) && isValidViaItem(request.resource.data);
      allow update: if isValidId(viaId) && isValidViaItem(request.resource.data);
      allow delete: if isValidId(viaId);
    }

    // 3. User Accounts (Staff and Admin)
    match /accounts/{accountId} {
      allow read: if true;
      // Chỉ cho phép tạo tài khoản staff, hoặc tạo tài khoản admin chuẩn của cualokhachsan@gmail.com
      allow create: if isValidId(accountId) && isValidAccount(request.resource.data) &&
                       (request.resource.data.role == 'staff' ||
                        (request.resource.data.role == 'admin' && 'email' in request.resource.data && request.resource.data.email.lower() == 'cualokhachsan@gmail.com') ||
                        isSuperAdmin());
      // Ngăn chặn tự nâng quyền từ staff lên admin, và cấm hạ quyền hoặc khóa tài khoản Master Admin (cualokhachsan@gmail.com)
      allow update: if isValidId(accountId) && isValidAccount(request.resource.data) &&
                       (request.resource.data.role == resource.data.role || isSuperAdmin()) &&
                       (!isProtectedMasterAdminDoc(accountId, resource.data) ||
                        (request.resource.data.role == 'admin' && request.resource.data.status == 'approved'));
      // Cấm xóa tài khoản Master Admin của cualokhachsan@gmail.com dưới mọi hình thức
      allow delete: if isValidId(accountId) &&
                       !isProtectedMasterAdminDoc(accountId, resource.data) &&
                       (!('role' in resource.data) || resource.data.role != 'admin' || isSuperAdmin());
    }

    // 4. System Settings & Cloud DB Bridge
    match /settings/{settingId} {
      allow read: if true;
      allow create: if isValidId(settingId) && isValidSetting(request.resource.data);
      allow update: if isValidId(settingId) && isValidSetting(request.resource.data);
      allow delete: if isValidId(settingId) && isSuperAdmin();
    }

    // 5. Shared Website & Tool Accounts
    match /sharedAccounts/{accountId} {
      allow read: if true;
      allow create: if isValidId(accountId) && isValidSharedAccount(request.resource.data);
      allow update: if isValidId(accountId) && isValidSharedAccount(request.resource.data);
      allow delete: if isValidId(accountId);
    }

    // 6. Group Facebook Records
    match /groupRecords/{recordId} {
      allow read: if true;
      allow create: if isValidId(recordId) && isValidGroupRecord(request.resource.data);
      allow update: if isValidId(recordId) && isValidGroupRecord(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    // 7. Proxies
    match /proxies/{proxyId} {
      allow read: if true;
      allow create: if isValidId(proxyId) && isValidProxyItem(request.resource.data);
      allow update: if isValidId(proxyId) && isValidProxyItem(request.resource.data);
      allow delete: if isValidId(proxyId);
    }

    // 8. Monthly Finances (Doanh thu & Thu chi từng tháng - Xác thực nghiêm ngặt)
    match /monthlyFinances/{monthId} {
      allow read: if true;
      allow create: if isValidId(monthId) && isValidMonthlyFinance(request.resource.data);
      allow update: if isValidId(monthId) && isValidMonthlyFinance(request.resource.data);
      allow delete: if isValidId(monthId);
    }

    // 9. Image Tasks (Nhiệm vụ làm ảnh & chia việc nhân viên - Xác thực nghiêm ngặt)
    match /imageTasks/{taskId} {
      allow read: if true;
      allow create: if isValidId(taskId) && isValidImageTask(request.resource.data);
      allow update: if isValidId(taskId) && isValidImageTask(request.resource.data);
      allow delete: if isValidId(taskId);
    }
  }
}
