{
  "entities": {
    "PageRecord": {
      "title": "PageRecord",
      "description": "Fanpage and daily posting progress record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "staffName": { "type": "string", "maxLength": 100 },
        "viaUid": { "type": "string", "maxLength": 100 },
        "fullVia": { "type": "string", "maxLength": 2000 },
        "pageName": { "type": "string", "maxLength": 200 },
        "pageLink": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Đề Xuất", "Mất Đề Xuất", "Đình Chỉ", "Bị Back"] },
        "date": { "type": "string", "maxLength": 50 },
        "blockStatus": { "type": "string", "enum": ["Không Chặn", "Chặn VN", "Chặn Bản Quyền", "Chặn Quốc Tế"] },
        "likeCountStatus": { "type": "string", "enum": ["Đếm Like", "Bỏ Đếm Like"] },
        "postingMethod": { "type": "string", "enum": ["Đăng Tay", "Tool", "Hẹn Giờ"] },
        "postingDate": { "type": "string", "maxLength": 50 },
        "interaction": { "type": "string", "enum": ["TỐT", "Bình Thường", "Kém", "Mất Tương Tác"] },
        "interactionDate": { "type": "string", "maxLength": 50 },
        "bmNote": { "type": "string", "maxLength": 500 },
        "targetPosts": { "type": "number" },
        "actualPosts": { "type": "number" },
        "isCompleted": { "type": "boolean" },
        "isViaError": { "type": "boolean" },
        "viaStatus": { "type": "string", "enum": ["active", "checkpoint", "dead", "error", "fixed"] },
        "viaErrorNote": { "type": "string", "maxLength": 500 },
        "isViaFixed": { "type": "boolean" },
        "viaSharedNote": { "type": "string", "maxLength": 500 },
        "viaTransferStatus": { "type": "string", "maxLength": 50 },
        "viaTransferNote": { "type": "string", "maxLength": 500 },
        "viaTransferColor": { "type": "string", "maxLength": 50 },
        "viaTransferUpdatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "staffName", "pageName", "targetPosts", "actualPosts", "isCompleted"]
    },
    "FullViaItem": {
      "title": "FullViaItem",
      "description": "Facebook Via account credentials (encrypted ENCv2 at rest) and assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 100 },
        "pass": { "type": "string", "maxLength": 1500 },
        "twoFa": { "type": "string", "maxLength": 1500 },
        "email": { "type": "string", "maxLength": 500 },
        "emailPass": { "type": "string", "maxLength": 1000 },
        "extraInfo": { "type": "string", "maxLength": 1500 },
        "staffName": { "type": "string", "maxLength": 100 },
        "note": { "type": "string", "maxLength": 500 },
        "sharedNote": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["active", "checkpoint", "dead", "error", "fixed"] },
        "adminReportStatus": { "type": "string", "maxLength": 50 },
        "pageUpdateStatus": { "type": "string", "maxLength": 50 },
        "groupJoinStatus": { "type": "string", "maxLength": 50 },
        "isError": { "type": "boolean" },
        "isFixed": { "type": "boolean" },
        "isEncrypted": { "type": "boolean" },
        "vaultVersion": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "rawFullVia": { "type": "string", "maxLength": 3000 }
      },
      "required": ["id", "uid", "staffName"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "User account for staff or admin with access control",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "status": { "type": "string", "enum": ["approved", "pending", "blocked"] },
        "pin": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "approvedAt": { "type": "string", "maxLength": 50 },
        "requestNote": { "type": "string", "maxLength": 500 },
        "adminNote": { "type": "string", "maxLength": 500 },
        "allowedTabs": { "type": "array" },
        "wpEmployeeCode": { "type": "string", "maxLength": 50 },
        "wpAllowedEmployeeCodes": { "type": "array" }
      },
      "required": ["id", "username", "role", "status"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Application security settings, DB bridge, and staff master list",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminPin": { "type": "string", "maxLength": 50 },
        "adminEmail": { "type": "string", "maxLength": 200 },
        "adminName": { "type": "string", "maxLength": 100 },
        "requireApproval": { "type": "boolean" },
        "requireGoogleLoginOnly": { "type": "boolean" },
        "customStaffList": { "type": "array" },
        "redirectConfigJson": { "type": "string", "maxLength": 5000 },
        "targetProjectId": { "type": "string", "maxLength": 200 },
        "targetDatabaseId": { "type": "string", "maxLength": 200 },
        "ownerEmail": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id"]
    },
    "SharedAccount": {
      "title": "SharedAccount",
      "description": "Shared tool or website credentials for staff with assignment permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "websiteName": { "type": "string", "maxLength": 200 },
        "websiteUrl": { "type": "string", "maxLength": 500 },
        "username": { "type": "string", "maxLength": 200 },
        "password": { "type": "string", "maxLength": 1000 },
        "twoFa": { "type": "string", "maxLength": 1000 },
        "assignedStaff": { "type": "array" },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "websiteName", "username", "password"]
    },
    "GroupRecord": {
      "title": "GroupRecord",
      "description": "Facebook group management record and via joining status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 100 },
        "groupName": { "type": "string", "maxLength": 200 },
        "groupLink": { "type": "string", "maxLength": 500 },
        "uid": { "type": "string", "maxLength": 100 },
        "viaName": { "type": "string", "maxLength": 100 },
        "joinStatus": { "type": "string", "enum": ["Đã Jon", "Jon chờ duyệt", "Chưa"] },
        "adminJoinReport": { "type": "string", "maxLength": 50 },
        "interactionStatus": { "type": "string", "enum": ["Đang lên tương tác", "Có tương tác", "Tương tác ổn", "Tương tác vừa", "Không có tương tác"] },
        "interactionDate": { "type": "string", "maxLength": 50 },
        "note": { "type": "string", "maxLength": 500 },
        "isHighlighted": { "type": "boolean" },
        "staffName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "groupName", "uid"]
    },
    "ProxyItem": {
      "title": "ProxyItem",
      "description": "Proxy connection details and staff assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ip": { "type": "string", "maxLength": 100 },
        "port": { "type": "string", "maxLength": 20 },
        "username": { "type": "string", "maxLength": 100 },
        "password": { "type": "string", "maxLength": 1000 },
        "protocol": { "type": "string", "enum": ["HTTP", "HTTPS", "SOCKS5"] },
        "fullProxy": { "type": "string", "maxLength": 1500 },
        "location": { "type": "string", "maxLength": 100 },
        "provider": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["active", "die", "expired", "checking"] },
        "assignedStaff": { "type": "array" },
        "assignedViaUids": { "type": "array" },
        "expireDate": { "type": "string", "maxLength": 50 },
        "note": { "type": "string", "maxLength": 500 },
        "isRotating": { "type": "boolean" },
        "rotateUrl": { "type": "string", "maxLength": 500 },
        "resetUrl": { "type": "string", "maxLength": 500 },
        "lastResetTime": { "type": "number" },
        "lastChecked": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "ip", "port"]
    },
    "MonthlyFinanceRecord": {
      "title": "MonthlyFinanceRecord",
      "description": "Monthly financial reports, revenue, utilities, unexpected expenses, and staff payroll",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "monthKey": { "type": "string", "maxLength": 50 },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "title": { "type": "string", "maxLength": 100 },
        "totalRevenue": { "type": "number" },
        "officeCost": { "type": "number" },
        "electricityCost": { "type": "number" },
        "waterCost": { "type": "number" },
        "totalSalary": { "type": "number" },
        "totalExpenses": { "type": "number" },
        "netProfit": { "type": "number" }
      },
      "required": ["id", "monthKey", "month", "year", "totalRevenue", "totalExpenses", "netProfit"]
    },
    "ImageTaskItem": {
      "title": "ImageTaskItem",
      "description": "Image editing and design task record for staff",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "assignedStaff": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "priority": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 2000 },
        "targetPage": { "type": "string", "maxLength": 200 },
        "deadline": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title"]
    }
  },
  "firestore": {
    "/pageRecords/{recordId}": {
      "schema": "PageRecord",
      "description": "Collection storing fanpage tracking records and posting progress"
    },
    "/vias/{viaId}": {
      "schema": "FullViaItem",
      "description": "Collection storing full via accounts and assignments"
    },
    "/accounts/{accountId}": {
      "schema": "UserAccount",
      "description": "Collection storing staff and admin accounts"
    },
    "/settings/{settingId}": {
      "schema": "AppSetting",
      "description": "Collection storing global system settings and DB bridge"
    },
    "/sharedAccounts/{accountId}": {
      "schema": "SharedAccount",
      "description": "Collection storing shared tool and website accounts"
    },
    "/groupRecords/{recordId}": {
      "schema": "GroupRecord",
      "description": "Collection storing Facebook group management records"
    },
    "/proxies/{proxyId}": {
      "schema": "ProxyItem",
      "description": "Collection storing proxy list and network configurations"
    },
    "/monthlyFinances/{monthId}": {
      "schema": "MonthlyFinanceRecord",
      "description": "Collection storing monthly finances and revenue management"
    },
    "/imageTasks/{taskId}": {
      "schema": "ImageTaskItem",
      "description": "Collection storing image tasks for staff"
    }
  }
}
